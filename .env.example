# WAY2GO SIH25082 Environment Configuration

# Frontend Public Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_frontend_google_maps_api_key_here

# Supabase Production Backend Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Backend Service Credentials (NEVER expose to browser)
GOOGLE_MAPS_API_KEY=your_backend_google_maps_api_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional AI API Key (Gemini / OpenAI)
AI_API_KEY=your_ai_api_key_here

# Routing Provider Configuration
ROUTING_PROVIDER=osrm
TRANSIT_PROVIDER=gtfs
